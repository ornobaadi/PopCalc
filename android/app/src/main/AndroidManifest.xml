<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <!-- Google Play Billing: premium skins and materials. -->
    <uses-permission
        android:name="com.android.vending.BILLING"/>
    <!-- Currency rates, only when the user taps Update in the converter
         (Play billing and updates use it too). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".PopCalcActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
        </activity>
        <!-- Launcher entries, one per app icon; exactly one is enabled at a time
             (switched by the popcalc/app_icon channel). The default keeps the old
             component name .MainActivity so existing home-screen shortcuts survive. -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAmber"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPercent"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_percent"
            android:roundIcon="@mipmap/ic_launcher_percent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPlusminus"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_plusminus"
            android:roundIcon="@mipmap/ic_launcher_plusminus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOperators"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_operators"
            android:roundIcon="@mipmap/ic_launcher_operators">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconKeypad"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_keypad"
            android:roundIcon="@mipmap/ic_launcher_keypad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRoot"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_root"
            android:roundIcon="@mipmap/ic_launcher_root">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRuler"
            android:targetActivity=".PopCalcActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_ruler"
            android:roundIcon="@mipmap/ic_launcher_ruler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Quick Settings tile: one tap opens PopCalc (PopCalcTileService). -->
        <service
            android:name=".PopCalcTileService"
            android:exported="true"
            android:label="PopCalc"
            android:icon="@drawable/ic_qs_popcalc"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>